# GEMINI_API_KEY: Server-side Gemini API key (required for Care Guide AI, Search/Maps Grounding, and Story Video Animation)
GEMINI_API_KEY="REPLACE_WITH_SERVER_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Public Google Maps JavaScript API key (restrict HTTP referrers in GCP Console)
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_FIREBASE_*: Public Firebase Web SDK identifiers (set in Vercel; keeps firebase-applet-config.json out of GitHub)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# APP_URL: The live URL where this application is hosted (e.g. https://hisandhers.vercel.app)
APP_URL="https://hisandhers.vercel.app"

# ADMIN_SECRET: Strong random 64+ hex signing secret for Stewardship CMS session cookies (required in production)
ADMIN_SECRET="REPLACE_WITH_CRYPTOGRAPHIC_RANDOM_HEX"

# ADMIN_EMAIL / ADMIN_PASSWORD: Administrator credentials for CMS dashboard (required in production)
ADMIN_EMAIL="admin@hisandhers.org"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSPHRASE"

