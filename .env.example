# GEMINI_API_KEY: Required if optional AI features are enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GLOW_ADMIN_SECRET: Signing secret for Admin CMS session cookies (change in production).
GLOW_ADMIN_SECRET="glow-church-africa-session-secret-change-in-prod"

# GLOW_ADMIN_EMAIL / GLOW_ADMIN_PASSWORD: Initial administrator credentials for CMS access.
GLOW_ADMIN_EMAIL="admin@glowchurchafrica.org"
GLOW_ADMIN_PASSWORD="GlowAdmin!2026"
