# GEMINI_API_KEY: Required if optional AI features are enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_SECRET: Signing secret for Stewardship CMS session cookies (change in production).
ADMIN_SECRET="his-and-hers-session-secret-change-in-prod"

# ADMIN_EMAIL / ADMIN_PASSWORD: Initial administrator credentials for CMS access.
ADMIN_EMAIL="admin@hisandhers.org"
ADMIN_PASSWORD="HisAndHersAdmin!2026"
